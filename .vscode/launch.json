{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: DRY RUN",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--root", "tests"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: WRITEE",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--root", "tests", "--write"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: CHECK",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--root", "tests", "--check"],
            "console": "integratedTerminal"
        }
    ]
}